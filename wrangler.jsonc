{
  "name": "zippytitleloans",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls invoke the Worker; static files are served directly.
    "run_worker_first": ["/api/*"]
  }
}
