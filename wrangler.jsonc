{
  "name": "zippytitleloans",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  // Form emails (see src/form.js). RESEND_API_KEY is a secret: set it in the dashboard.
  "vars": {
    "CONTACT_TO": "leads@getmarketingbull.com",
    "CONTACT_FROM": "Zippy Title Loans <noreply@getmarketingbull.com>"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls invoke the Worker; static files are served directly.
    "run_worker_first": ["/api/*"]
  }
}
